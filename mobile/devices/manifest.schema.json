{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pluseight8/omarchy-mobile/blob/main/mobile/devices/manifest.schema.json",
  "type": "object",
  "required": ["schemaVersion", "id", "status", "supportLevel", "realHardwareValidated", "boot", "capabilities", "validation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "vendor": { "type": "string" },
    "model": { "type": "string" },
    "status": { "enum": ["untested", "experimental", "validated", "retired"] },
    "supportLevel": { "enum": ["planned", "experimental", "partial", "supported"] },
    "realHardwareValidated": { "type": "boolean" },
    "lastValidatedAt": { "type": ["string", "null"] },
    "boot": {
      "type": "object",
      "required": ["imagesAvailable", "installerAvailable", "recovery"],
      "properties": {
        "imagesAvailable": { "type": "boolean" },
        "installerAvailable": { "type": "boolean" },
        "recovery": { "type": "string" }
      },
      "additionalProperties": true
    },
    "capabilities": { "type": "object", "additionalProperties": { "type": "object" } },
    "validation": { "type": "object" }
  },
  "additionalProperties": true
}
